# ============================================================
# .gitignore — quantum-clinical-trial-optimization
#
# Policy:
#   - Never commit large/raw/interim artifacts
#   - Commit only small, reproducible reference artifacts
#   - Outputs are generally ignored, except slide decks we publish
# ============================================================

# ---------------------------
# Python / Jupyter / tooling
# ---------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Environments
.env
.venv/
env/
venv/

# ---------------------------
# OS / editor noise
# ---------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# ---------------------------
# Credentials / local state
# ---------------------------
existing_keys.json
*.log

# ---------------------------
# Large raw inputs / extracts
# ---------------------------
ctgov_full_studies.zip
clinical_trials_extracted/
# If you later mirror any raw S3-like trees locally, ignore them here:
# clinical-trials-data/raw/

# ---------------------------
# Generated outputs (default: ignore)
# ---------------------------
logs/

# Ignore all outputs by default...
outputs/*
# ...but allow slide decks we intentionally publish
!outputs/slides/
outputs/slides/*
!outputs/slides/*.pptx

# ---------------------------
# Project data layers (generated or large)
# ---------------------------
data/raw/
data/interim/
data/curated/

# We usually keep summary outputs out of git; if you later want to publish specific
# summaries, prefer copying them into docs/ or data/samples/
data/summary/

# ---------------------------
# Common large artifacts anywhere (safety net)
# ---------------------------
*.parquet
*.csv.gz

# ---------------------------
# Allow-list: small, shareable samples
# ---------------------------
!data/samples/
!data/samples/**

# Ignore local 03e run outputs (derived) — keep the canonical Scenario A artifacts
data/results/03e_*

# ---------------------------
# Results hygiene (keep repo clean)
# ---------------------------
# Checkpoints / partials should not be versioned
data/results/*checkpoint*.csv
data/results/*partial*.csv

# Generated runner scripts should not be versioned
data/results/_run_*.py

# ---------------------------
# Docs artifacts we DO publish
# ---------------------------
!docs/slide_assets.zip
!docs/slide_assets/**
